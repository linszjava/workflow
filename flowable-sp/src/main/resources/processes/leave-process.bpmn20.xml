<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://www.flowable.org/processdef">
  <process id="leaveProcess" name="请假流程" isExecutable="true">
    <!-- ========== 1. 开始节点 ========== -->
    <startEvent id="startEvent" name="提交申请"/>
    <sequenceFlow id="flow_start" sourceRef="startEvent" targetRef="managerTask"/>
    <userTask id="managerTask" name="部门经理审批">
      <extensionElements>
        <flowable:taskListener event="create" delegateExpression="${bossTaskListener}" />
      </extensionElements>
    </userTask>
    <!-- 边界定时逃生阀: 1分钟不批触发 -->
    <boundaryEvent id="urgeTimer" attachedToRef="managerTask" cancelActivity="false">
      <timerEventDefinition>
        <timeDuration>PT1M</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="flow_timer_to_urge" sourceRef="urgeTimer" targetRef="urgeServiceTask" />
    <serviceTask id="urgeServiceTask" name="发送催办提醒" flowable:delegateExpression="${urgeService}" />
    <sequenceFlow id="flow_urge_end" sourceRef="urgeServiceTask" targetRef="urgeEndEvent" />
    <endEvent id="urgeEndEvent" name="催办结束" />
    <sequenceFlow id="flow_manager_to_gw" sourceRef="managerTask" targetRef="managerGateway"/>
    <!-- ========== 3. 经理审批网关 ========== -->
    <exclusiveGateway id="managerGateway" name="经理审批结果"/>
    <!-- 3a. 经理通过 → 评估天数网关 -->
    <sequenceFlow id="flow_mgr_approve" sourceRef="managerGateway" targetRef="daysGateway">
      <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
    </sequenceFlow>
    
    <exclusiveGateway id="daysGateway" name="请假天数评估"/>
    
    <!-- 评估1：天数 < 5, 直通 HR -->
    <sequenceFlow id="flow_days_less" sourceRef="daysGateway" targetRef="hrTask">
      <conditionExpression xsi:type="tFormalExpression">${days &lt; 5}</conditionExpression>
    </sequenceFlow>

    <!-- 评估2：天数 >= 5, 挂起当期进城，进入外挂子系统 (Call Activity) -->
    <sequenceFlow id="flow_days_more" sourceRef="daysGateway" targetRef="bossSubProcess">
      <conditionExpression xsi:type="tFormalExpression">${days &gt;= 5}</conditionExpression>
    </sequenceFlow>
    
    <callActivity id="bossSubProcess" name="外挂老板特批" calledElement="bossSignProcess">
      <extensionElements>
        <!-- 压入参数，注意 bizId 我们稍后在代码里会补上 -->
        <flowable:in source="initiator" target="initiator"/>
        <flowable:in source="bizId" target="bizId"/>
        <!-- 抽回特批结果 -->
        <flowable:out source="approved" target="bossApproved"/>
      </extensionElements>
    </callActivity>
    
    <sequenceFlow id="flow_boss_to_gw" sourceRef="bossSubProcess" targetRef="bossGateway"/>
    <exclusiveGateway id="bossGateway" name="老板审批结果"/>
    
    <!-- 老板同意，继续汇流至 HR审批 -->
    <sequenceFlow id="flow_boss_approve" sourceRef="bossGateway" targetRef="hrTask">
      <conditionExpression xsi:type="tFormalExpression">${bossApproved == true}</conditionExpression>
    </sequenceFlow>
    
    <!-- 老板驳回，直接退回申请人节点 -->
    <sequenceFlow id="flow_boss_reject" sourceRef="bossGateway" targetRef="modifyTask">
      <conditionExpression xsi:type="tFormalExpression">${bossApproved == false}</conditionExpression>
    </sequenceFlow>
    <!-- 3b. 经理驳回 → 退回给申请人修改 -->
    <sequenceFlow id="flow_mgr_reject" sourceRef="managerGateway" targetRef="modifyTask">
      <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
    </sequenceFlow>
    <!-- ========== 4. HR审批（候选组） ========== -->
    <userTask id="hrTask" name="HR审批" flowable:candidateGroups="hrGroup"/>
    <sequenceFlow id="flow_hr_to_gw" sourceRef="hrTask" targetRef="hrGateway"/>
    <!-- ========== 5. HR审批网关 ========== -->
    <exclusiveGateway id="hrGateway" name="HR审批结果"/>
    <!-- 5a. HR通过 → 自动归档系统 -->
    <sequenceFlow id="flow_hr_approve" sourceRef="hrGateway" targetRef="archiveServiceTask">
      <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="archiveServiceTask" name="自动归档处理" flowable:delegateExpression="${autoArchiveService}" />
    <sequenceFlow id="flow_archive_end" sourceRef="archiveServiceTask" targetRef="endEvent" />
    <!-- 5b. HR驳回 → 退回给申请人修改 -->
    <sequenceFlow id="flow_hr_reject" sourceRef="hrGateway" targetRef="modifyTask">
      <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
    </sequenceFlow>
    <!-- ========== 6. 申请人修改（动态指定为发起人） ========== -->
    <userTask id="modifyTask" name="申请人修改" flowable:assignee="${initiator}"/>
    <sequenceFlow id="flow_modify_to_gw" sourceRef="modifyTask" targetRef="modifyGateway"/>
    <!-- ========== 7. 修改后的选择网关 ========== -->
    <exclusiveGateway id="modifyGateway" name="修改后操作"/>
    <!-- 7a. 重新提交 → 回到部门经理审批（形成循环） -->
    <sequenceFlow id="flow_resubmit" sourceRef="modifyGateway" targetRef="managerTask">
      <conditionExpression xsi:type="tFormalExpression">${resubmit == true}</conditionExpression>
    </sequenceFlow>
    <!-- 7b. 撤回申请 → 结束 -->
    <sequenceFlow id="flow_withdraw" sourceRef="modifyGateway" targetRef="endEvent">
      <conditionExpression xsi:type="tFormalExpression">${resubmit == false}</conditionExpression>
    </sequenceFlow>
    <!-- ========== 8. 结束节点 ========== -->
    <endEvent id="endEvent" name="结束"/>
  </process>
  <!-- 流程图坐标 -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_leaveProcess">
    <bpmndi:BPMNPlane bpmnElement="leaveProcess" id="BPMNPlane_leaveProcess">
      <bpmndi:BPMNShape bpmnElement="startEvent" id="s1">
        <omgdc:Bounds height="30.0" width="30.0" x="60.0" y="165.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="managerTask" id="s2">
        <omgdc:Bounds height="80.0" width="100.0" x="140.0" y="140.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="managerGateway" id="s3">
        <omgdc:Bounds height="40.0" width="40.0" x="290.0" y="160.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="hrTask" id="s4">
        <omgdc:Bounds height="80.0" width="100.0" x="380.0" y="140.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="hrGateway" id="s5">
        <omgdc:Bounds height="40.0" width="40.0" x="530.0" y="160.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="modifyTask" id="s6">
        <omgdc:Bounds height="80.0" width="100.0" x="380.0" y="300.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="modifyGateway" id="s7">
        <omgdc:Bounds height="40.0" width="40.0" x="170.0" y="320.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="endEvent" id="s8">
        <omgdc:Bounds height="28.0" width="28.0" x="780.0" y="166.0"/>
      </bpmndi:BPMNShape>
      
      <!-- 外挂天数分支组件占位 -->
      <bpmndi:BPMNShape bpmnElement="daysGateway" id="s_days_gw">
        <omgdc:Bounds height="40.0" width="40.0" x="330.0" y="50.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="bossSubProcess" id="s_boss_sub">
        <omgdc:Bounds height="80.0" width="100.0" x="420.0" y="30.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="bossGateway" id="s_boss_gw">
        <omgdc:Bounds height="40.0" width="40.0" x="550.0" y="50.0"/>
      </bpmndi:BPMNShape>
      
      <!-- 新增件：定时器与催办分支 -->
      <bpmndi:BPMNShape bpmnElement="urgeTimer" id="s_timer">
        <omgdc:Bounds height="30.0" width="30.0" x="180.0" y="205.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="urgeServiceTask" id="s_urge_task">
        <omgdc:Bounds height="80.0" width="100.0" x="140.0" y="260.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="urgeEndEvent" id="s_urge_end">
        <omgdc:Bounds height="28.0" width="28.0" x="176.0" y="380.0"/>
      </bpmndi:BPMNShape>
      
      <!-- 新增件：自动归档机器件 -->
      <bpmndi:BPMNShape bpmnElement="archiveServiceTask" id="s_archive_task">
        <omgdc:Bounds height="80.0" width="100.0" x="620.0" y="140.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="flow_start" id="BPMNEdge_flow_start">
        <omgdi:waypoint x="90.0" y="180.0"/>
        <omgdi:waypoint x="140.0" y="180.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_manager_to_gw" id="BPMNEdge_flow_manager_to_gw">
        <omgdi:waypoint x="240.0" y="180.0"/>
        <omgdi:waypoint x="290.0" y="180.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_mgr_approve" id="BPMNEdge_flow_mgr_approve">
        <omgdi:waypoint x="330.0" y="180.0"/>
        <omgdi:waypoint x="380.0" y="180.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_mgr_reject" id="BPMNEdge_flow_mgr_reject">
        <omgdi:waypoint x="310.0" y="200.0"/>
        <omgdi:waypoint x="310.0" y="340.0"/>
        <omgdi:waypoint x="380.0" y="340.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_hr_to_gw" id="BPMNEdge_flow_hr_to_gw">
        <omgdi:waypoint x="480.0" y="180.0"/>
        <omgdi:waypoint x="530.0" y="180.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_hr_approve" id="BPMNEdge_flow_hr_approve">
        <omgdi:waypoint x="570.0" y="180.0"/>
        <omgdi:waypoint x="620.0" y="180.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_archive_end" id="BPMNEdge_flow_archive_end">
        <omgdi:waypoint x="720.0" y="180.0"/>
        <omgdi:waypoint x="780.0" y="180.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_timer_to_urge" id="BPMNEdge_flow_timer">
        <omgdi:waypoint x="195.0" y="235.0"/>
        <omgdi:waypoint x="190.0" y="260.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_urge_end" id="BPMNEdge_flow_urge_end">
        <omgdi:waypoint x="190.0" y="340.0"/>
        <omgdi:waypoint x="190.0" y="380.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_hr_reject" id="BPMNEdge_flow_hr_reject">
        <omgdi:waypoint x="550.0" y="200.0"/>
        <omgdi:waypoint x="550.0" y="340.0"/>
        <omgdi:waypoint x="480.0" y="340.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_modify_to_gw" id="BPMNEdge_flow_modify_to_gw">
        <omgdi:waypoint x="380.0" y="340.0"/>
        <omgdi:waypoint x="210.0" y="340.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_resubmit" id="BPMNEdge_flow_resubmit">
        <omgdi:waypoint x="190.0" y="320.0"/>
        <omgdi:waypoint x="190.0" y="220.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow_withdraw" id="BPMNEdge_flow_withdraw">
        <omgdi:waypoint x="190.0" y="360.0"/>
        <omgdi:waypoint x="190.0" y="420.0"/>
        <omgdi:waypoint x="654.0" y="420.0"/>
        <omgdi:waypoint x="654.0" y="194.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
